DISCORD_TOKEN=tu_token_de_discord
DATABASE_URL=
# Opcional si no usas DATABASE_URL directamente:
# PGHOST=host
# PGPORT=5432
# PGDATABASE=database
# PGUSER=usuario
# PGPASSWORD=password

# Bridge scraping endpoint (local/VPS/localtunnel)
# SCRAPER_BRIDGE_URL=https://tu-bridge.loca.lt

# Shared secret expected by the bridge in X-API-KEY
# API_SECRET=change_this_secret

# Set false when bridge URL has certificate mismatch (common with localtunnel)
# BRIDGE_VERIFY_SSL=false
